# Database (used by docker-compose.yml AND the app's DATABASE_URL below)
POSTGRES_DB="vapestore"
POSTGRES_USER="vapeuser"
POSTGRES_PASSWORD="vapepass"
DATABASE_URL="postgresql://vapeuser:vapepass@localhost:5432/vapestore?schema=public"

# Auth.js
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Comma-separated list of Google account emails allowed into /admin
ALLOWED_ADMIN_EMAILS="owner@example.com"

# Cloudflare R2 (S3-compatible object storage for product/banner images)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="vape-store-images"
R2_PUBLIC_URL="https://images.vapestore.example.com"

NODE_ENV="development"
